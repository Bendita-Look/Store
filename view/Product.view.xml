<mvc:View
    controllerName="apps.dflc.benditalook.controller.Product"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Page id="productPage" class="blPage">
        <customHeader>
            <core:Fragment fragmentName="apps.dflc.benditalook.view.fragments.StoreHeader" type="XML" />
        </customHeader>
        <content>
            <FlexBox
                wrap="Wrap"
                alignItems="Start"
                justifyContent="Center"
                visible="{product>/loaded}"
                class="blContainer blProductDetail"
            >
                <VBox class="blGallery">
                    <Carousel
                        id="productCarousel"
                        height="auto"
                        pages="{path: 'product>/images', templateShareable: false}"
                        visible="{= ${product>/images}.length > 0 }"
                        showPageIndicator="{= ${product>/images}.length > 1 }"
                        class="blCarousel"
                    >
                        <Image
                            src="{path: 'product>ID', formatter: '.formatter.catalogImageUrl'}"
                            alt="{product>/product/Name}"
                            width="100%"
                            densityAware="false"
                            class="blDetailImage"
                        />
                    </Carousel>
                    <Image
                        src="img/placeholder.svg"
                        width="100%"
                        visible="{= ${product>/images}.length === 0 }"
                        class="blDetailImage"
                    />
                    <HBox
                        items="{path: 'product>/images', templateShareable: false}"
                        visible="{= ${product>/images}.length > 1 }"
                        wrap="Wrap"
                        class="blThumbnails"
                    >
                        <Image
                            src="{path: 'product>ID', formatter: '.formatter.catalogImageUrl'}"
                            alt="{product>/product/Name}"
                            width="4rem"
                            height="5.25rem"
                            densityAware="false"
                            press=".onThumbnailPress"
                            class="blThumbnail"
                        />
                    </HBox>
                </VBox>

                <VBox class="blDetailInfo">
                    <Text text="{product>/product/Category/Name}" class="blCategoryLabel" />
                    <Title text="{product>/product/Name}" level="H1" wrapping="true" class="blDetailTitle" />
                    <Text
                        text="{path: 'product>/product/Price', targetType: 'any', formatter: '.formatter.currency'}"
                        class="blDetailPrice"
                    />
                    <Text text="{product>/product/Description}" class="blDetailDescription" />

                    <VBox visible="{= ${product>/colors}.length > 0 }" class="blOptionGroup">
                        <Text text="{parts: ['i18n>colorSelected', 'product>/selectedColorName'], formatter: '.formatter.message'}" class="blOptionLabel" />
                        <HBox items="{path: 'product>/colors', templateShareable: false}" wrap="Wrap" class="blSwatches">
                            <core:Icon
                                src="sap-icon://circle-task-2"
                                color="{= ${product>HexCode} || '#d9c3b0' }"
                                size="1.75rem"
                                tooltip="{product>Name}"
                                press=".onSwatchPress"
                                class="blSwatch"
                            >
                                <core:customData>
                                    <core:CustomData
                                        key="selected"
                                        value="{= ${product>ID} === ${product>/selectedColorId} ? 'true' : 'false' }"
                                        writeToDom="true"
                                    />
                                </core:customData>
                            </core:Icon>
                        </HBox>
                    </VBox>

                    <VBox class="blOptionGroup">
                        <Text text="{i18n>size}" class="blOptionLabel" />
                        <HBox items="{path: 'product>/sizes', templateShareable: false}" wrap="Wrap" class="blSizes">
                            <Button
                                text="{product>text}"
                                type="{= ${product>key} === ${product>/selectedVariantId} ? 'Emphasized' : 'Default' }"
                                enabled="{product>enabled}"
                                press=".onSizePress"
                                class="blSize"
                            />
                        </HBox>
                        <ObjectStatus
                            text="{parts: ['i18n>inStock', 'i18n>soldOut', 'product>/stock'], formatter: '.formatter.stockMessage'}"
                            state="{= ${product>/stock} > 0 ? 'Success' : 'Error' }"
                            class="sapUiTinyMarginTop"
                        />
                    </VBox>

                    <HBox alignItems="End" class="blBuyBox">
                        <StepInput
                            value="{product>/quantity}"
                            min="1"
                            max="{= Math.max(${product>/stock}, 1) }"
                            enabled="{= ${product>/stock} > 0 }"
                            width="8rem"
                            class="sapUiSmallMarginEnd"
                        />
                        <Button
                            text="{i18n>addToCart}"
                            icon="sap-icon://cart-4"
                            type="Emphasized"
                            enabled="{= ${product>/stock} > 0 }"
                            press=".onAddToCart"
                            class="blPrimaryButton blBuyButton"
                        />
                    </HBox>

                    <Link
                        text="{i18n>productQuestion}"
                        visible="{= !!${store>/Whatsapp} }"
                        press=".onAskAboutProduct"
                        class="blProductQuestion"
                    />

                    <VBox class="blDetailBenefits">
                        <HBox alignItems="Center">
                            <core:Icon src="sap-icon://retail-store" class="blDetailBenefitIcon" />
                            <Text text="{i18n>benefitPickupText}" />
                        </HBox>
                        <HBox alignItems="Center">
                            <core:Icon src="sap-icon://cart-approval" class="blDetailBenefitIcon" />
                            <Text text="{i18n>benefitReserveText}" />
                        </HBox>
                    </VBox>
                </VBox>
            </FlexBox>

            <core:Fragment fragmentName="apps.dflc.benditalook.view.fragments.StoreFooter" type="XML" />
        </content>
    </Page>
</mvc:View>
