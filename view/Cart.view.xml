<mvc:View
    controllerName="apps.dflc.benditalook.controller.Cart"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>
    <Page id="cartPage" class="blPage">
        <customHeader>
            <core:Fragment fragmentName="apps.dflc.benditalook.view.fragments.StoreHeader" type="XML" />
        </customHeader>
        <content>
            <IllustratedMessage
                illustrationType="sapIllus-EmptyList"
                title="{i18n>emptyCartTitle}"
                description="{i18n>emptyCartDescription}"
                visible="{= ${cart>/count} === 0 }"
            >
                <additionalContent>
                    <Button text="{i18n>continueShopping}" type="Emphasized" press=".onContinueShopping" />
                </additionalContent>
            </IllustratedMessage>

            <VBox visible="{= ${cart>/count} > 0 }" class="blContainer">
                <Title text="{i18n>cartTitle}" level="H1" titleStyle="H3" class="sapUiSmallMarginBottom" />

                <List items="{cart>/items}" class="blCartList">
                    <CustomListItem>
                        <HBox alignItems="Center" class="blCartItem">
                            <Image
                                src="{path: 'cart>ImageId', formatter: '.formatter.catalogImageUrl'}"
                                width="4.5rem"
                                height="6rem"
                                densityAware="false"
                                class="blCartImage sapUiSmallMarginEnd"
                            />
                            <VBox class="blCartItemInfo">
                                <Text text="{cart>ProductName}" class="blProductName" />
                                <Text text="{parts: ['cart>ColorName', 'cart>Size'], formatter: '.formatter.variantDescription'}" class="blMuted" />
                                <Text text="{path: 'cart>UnitPrice', targetType: 'any', formatter: '.formatter.currency'}" class="blProductPrice" />
                            </VBox>
                            <StepInput
                                value="{cart>Quantity}"
                                min="1"
                                max="{cart>MaxQuantity}"
                                width="7rem"
                                change=".onQuantityChange"
                            />
                            <Button
                                icon="sap-icon://delete"
                                type="Transparent"
                                tooltip="{i18n>remove}"
                                press=".onRemoveItem"
                            />
                        </HBox>
                    </CustomListItem>
                </List>

                <VBox class="blSummary sapUiSmallMarginTop">
                    <HBox alignItems="End" class="sapUiSmallMarginBottom">
                        <Input
                            value="{checkout>/couponInput}"
                            placeholder="{i18n>couponPlaceholder}"
                            width="14rem"
                            maxLength="20"
                            submit=".onApplyCoupon"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button text="{i18n>applyCoupon}" press=".onApplyCoupon" class="sapUiTinyMarginEnd" />
                        <Button
                            icon="sap-icon://decline"
                            type="Transparent"
                            tooltip="{i18n>removeCoupon}"
                            visible="{= !!${checkout>/data/CouponCode} }"
                            press=".onRemoveCoupon"
                        />
                    </HBox>
                    <ObjectStatus
                        text="{checkout>/quote/CouponMessage}"
                        state="{path: 'checkout>/quote/CouponStatus', formatter: '.formatCouponState'}"
                        visible="{= !!${checkout>/quote/CouponMessage} }"
                        class="sapUiSmallMarginBottom"
                    />

                    <List
                        items="{checkout>/quote/Promotions}"
                        visible="{= !!${checkout>/quote/Promotions} &amp;&amp; ${checkout>/quote/Promotions}.length > 0 }"
                        headerText="{i18n>appliedPromotions}"
                        showSeparators="None"
                        class="blPromotionList"
                    >
                        <StandardListItem
                            icon="{= ${checkout>RewardType} === 'GIFT' ? 'sap-icon://gift' : 'sap-icon://lead' }"
                            title="{checkout>PromotionName}"
                            description="{checkout>GiftDescription}"
                            info="{path: 'checkout>DiscountAmount', formatter: '.formatter.negativeAmount'}"
                            infoState="Success"
                        />
                    </List>

                    <HBox justifyContent="End" alignItems="Center" visible="{= ${checkout>/quote/DiscountAmount} > 0 }">
                        <Text text="{i18n>subtotal}" class="sapUiSmallMarginEnd" />
                        <Text text="{path: 'checkout>/quote/SubtotalAmount', formatter: '.formatter.currency'}" />
                    </HBox>
                    <HBox justifyContent="End" alignItems="Center" visible="{= ${checkout>/quote/DiscountAmount} > 0 }">
                        <Text text="{i18n>discount}" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{path: 'checkout>/quote/DiscountAmount', formatter: '.formatter.negativeAmount'}" state="Success" />
                    </HBox>
                    <HBox justifyContent="End" alignItems="Center" class="blCartTotal">
                        <Text text="{i18n>total}" class="sapUiSmallMarginEnd" />
                        <Text
                            text="{parts: ['checkout>/quote/TotalAmount', 'cart>/total'], formatter: '.formatter.firstAmount'}"
                            class="blDetailPrice"
                        />
                    </HBox>
                    <Text
                        text="{i18n>shippingNotIncluded}"
                        textAlign="End"
                        width="100%"
                        visible="{= ${checkout>/data/FulfillmentType} === 'DELIVERY' }"
                        class="blShippingNote"
                    />
                </VBox>

                <MessageStrip
                    text="{i18n>checkoutInfo}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginTopBottom"
                />
                <MessageStrip
                    text="{i18n>shippingInfo}"
                    type="Information"
                    showIcon="true"
                    visible="{= ${checkout>/data/FulfillmentType} === 'DELIVERY' }"
                    class="sapUiSmallMarginBottom"
                />

                <form:SimpleForm
                    editable="true"
                    layout="ColumnLayout"
                    columnsM="2"
                    columnsL="2"
                    columnsXL="2"
                    title="{i18n>contactTitle}"
                    class="blForm"
                >
                    <Label text="{i18n>customerName}" required="true" />
                    <Input
                        value="{checkout>/data/CustomerName}"
                        valueState="{checkout>/states/CustomerName}"
                        valueStateText="{i18n>customerNameInvalid}"
                        maxLength="120"
                        change=".onContactChange"
                    />
                    <Label text="{i18n>customerPhone}" required="true" />
                    <Input
                        value="{checkout>/data/CustomerPhone}"
                        valueState="{checkout>/states/CustomerPhone}"
                        valueStateText="{i18n>customerPhoneInvalid}"
                        placeholder="{i18n>customerPhonePlaceholder}"
                        type="Tel"
                        maxLength="20"
                        change=".onContactChange"
                    />
                    <Label text="{i18n>customerEmail}" required="true" />
                    <Input
                        value="{checkout>/data/CustomerEmail}"
                        valueState="{checkout>/states/CustomerEmail}"
                        valueStateText="{i18n>customerEmailInvalid}"
                        type="Email"
                        maxLength="120"
                        change=".onContactChange"
                    />
                    <Label text="{i18n>notes}" />
                    <TextArea value="{checkout>/data/Notes}" maxLength="500" rows="2" growing="true" />
                </form:SimpleForm>

                <form:SimpleForm
                    editable="true"
                    layout="ColumnLayout"
                    columnsM="2"
                    columnsL="2"
                    columnsXL="2"
                    title="{i18n>fulfillmentTitle}"
                    class="blForm sapUiSmallMarginTop"
                >
                    <Label text="{i18n>fulfillmentType}" />
                    <SegmentedButton selectedKey="{checkout>/data/FulfillmentType}" selectionChange=".onFulfillmentChange">
                        <items>
                            <SegmentedButtonItem key="DELIVERY" text="{i18n>fulfillment.DELIVERY}" icon="sap-icon://shipping-status" />
                            <SegmentedButtonItem key="PICKUP" text="{i18n>fulfillment.PICKUP}" icon="sap-icon://retail-store" />
                        </items>
                    </SegmentedButton>

                    <Label text="{i18n>pickupAddress}" visible="{= ${checkout>/data/FulfillmentType} === 'PICKUP' }" />
                    <Text
                        text="{= ${store>/PickupAddress} || ${i18n>pickupAddressToConfirm} }"
                        visible="{= ${checkout>/data/FulfillmentType} === 'PICKUP' }"
                    />

                    <Label text="{i18n>zipCode}" required="true" visible="{= ${checkout>/data/FulfillmentType} === 'DELIVERY' }" />
                    <MaskInput
                        value="{checkout>/data/ZipCode}"
                        mask="99999-999"
                        placeholderSymbol="_"
                        valueState="{checkout>/states/ZipCode}"
                        valueStateText="{i18n>zipCodeInvalid}"
                        busy="{checkout>/zipLoading}"
                        busyIndicatorDelay="0"
                        change=".onZipCodeChange"
                        visible="{= ${checkout>/data/FulfillmentType} === 'DELIVERY' }"
                    />
                    <Link
                        text="{i18n>zipCodeHelp}"
                        href="https://buscacepinter.correios.com.br/"
                        target="_blank"
                        visible="{= ${checkout>/data/FulfillmentType} === 'DELIVERY' }"
                    />
                    <Label text="{i18n>address}" required="true" visible="{= ${checkout>/data/FulfillmentType} === 'DELIVERY' }" />
                    <Input
                        value="{checkout>/data/Address}"
                        editable="{= !${checkout>/locks/Address} }"
                        valueState="{checkout>/states/Address}"
                        maxLength="200"
                        change=".onContactChange"
                        visible="{= ${checkout>/data/FulfillmentType} === 'DELIVERY' }"
                    />
                    <Label text="{i18n>addressNumber}" required="true" visible="{= ${checkout>/data/FulfillmentType} === 'DELIVERY' }" />
                    <Input
                        value="{checkout>/data/AddressNumber}"
                        valueState="{checkout>/states/AddressNumber}"
                        valueStateText="{i18n>addressNumberInvalid}"
                        maxLength="20"
                        change=".onContactChange"
                        visible="{= ${checkout>/data/FulfillmentType} === 'DELIVERY' }"
                    />
                    <Label text="{i18n>complement}" visible="{= ${checkout>/data/FulfillmentType} === 'DELIVERY' }" />
                    <Input
                        value="{checkout>/data/Complement}"
                        placeholder="{i18n>complementPlaceholder}"
                        maxLength="80"
                        change=".onContactChange"
                        visible="{= ${checkout>/data/FulfillmentType} === 'DELIVERY' }"
                    />
                    <Label text="{i18n>district}" required="true" visible="{= ${checkout>/data/FulfillmentType} === 'DELIVERY' }" />
                    <Input
                        value="{checkout>/data/District}"
                        editable="{= !${checkout>/locks/District} }"
                        valueState="{checkout>/states/District}"
                        maxLength="80"
                        change=".onContactChange"
                        visible="{= ${checkout>/data/FulfillmentType} === 'DELIVERY' }"
                    />
                    <Label text="{i18n>city}" required="true" visible="{= ${checkout>/data/FulfillmentType} === 'DELIVERY' }" />
                    <Input
                        value="{checkout>/data/City}"
                        editable="{= !${checkout>/locks/City} }"
                        valueState="{checkout>/states/City}"
                        maxLength="80"
                        change=".onContactChange"
                        visible="{= ${checkout>/data/FulfillmentType} === 'DELIVERY' }"
                    />
                    <Label text="{i18n>state}" required="true" visible="{= ${checkout>/data/FulfillmentType} === 'DELIVERY' }" />
                    <Input
                        value="{checkout>/data/State}"
                        editable="{= !${checkout>/locks/State} }"
                        valueState="{checkout>/states/State}"
                        placeholder="{i18n>statePlaceholder}"
                        maxLength="2"
                        change=".onContactChange"
                        visible="{= ${checkout>/data/FulfillmentType} === 'DELIVERY' }"
                    />
                </form:SimpleForm>

                <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="sapUiMediumMarginTop">
                    <Link
                        text="{i18n>forgetMyData}"
                        visible="{checkout>/hasRememberedData}"
                        press=".onForgetContact"
                        class="sapUiSmallMarginBottom"
                    />
                    <HBox>
                        <Button text="{i18n>continueShopping}" press=".onContinueShopping" class="sapUiSmallMarginEnd" />
                        <Button
                            text="{i18n>submitOrder}"
                            icon="sap-icon://paper-plane"
                            type="Emphasized"
                            press=".onSubmitOrder"
                            class="blPrimaryButton"
                        />
                    </HBox>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
