<mvc:View
    controllerName="apps.dflc.benditalook.controller.Catalog"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:grid="sap.ui.layout.cssgrid"
    xmlns:core="sap.ui.core"
>
    <Page id="catalogPage" class="blPage">
        <customHeader>
            <core:Fragment fragmentName="apps.dflc.benditalook.view.fragments.StoreHeader" type="XML" />
        </customHeader>
        <content>
            <HBox
                items="{catalogView>/promotions}"
                visible="{= ${catalogView>/promotions}.length > 0 }"
                justifyContent="Center"
                alignItems="Center"
                wrap="Wrap"
                class="blAnnouncement"
            >
                <HBox alignItems="Center" class="blAnnouncementItem">
                    <core:Icon src="sap-icon://lead" class="blAnnouncementIcon" />
                    <Text text="{catalogView>Name}" class="blAnnouncementName" />
                    <Text text="{catalogView>Description}" visible="{= !!${catalogView>Description} }" class="blAnnouncementText" />
                </HBox>
            </HBox>

            <Image
                src="{parts: ['store>/BannerId', 'store>/BannerVersion'], formatter: '.formatter.bannerUrl'}"
                visible="{= !!${store>/BannerId} }"
                alt="{i18n>appTitle}"
                densityAware="false"
                press=".onShopNow"
                class="blHeroBanner"
            />

            <FlexBox alignItems="Center" justifyContent="Center" wrap="Wrap" visible="{= !${store>/BannerId} }" class="blHero">
                <VBox class="blHeroText">
                    <Text text="{i18n>heroEyebrow}" class="blHeroEyebrow" />
                    <Title text="{i18n>heroTitle}" level="H1" wrapping="true" class="blHeroTitle" />
                    <Text text="{i18n>heroSubtitle}" class="blHeroSubtitle" />
                    <Button text="{i18n>heroAction}" type="Emphasized" press=".onShopNow" class="blPrimaryButton blHeroButton" />
                </VBox>
                <Image src="img/logo.webp" alt="{i18n>appTitle}" densityAware="false" class="blHeroLogo" />
            </FlexBox>

            <FlexBox justifyContent="Center" wrap="Wrap" class="blBenefits">
                <HBox alignItems="Center" class="blBenefit">
                    <core:Icon src="sap-icon://discussion" class="blBenefitIcon" />
                    <VBox>
                        <Text text="{i18n>benefitWhatsappTitle}" class="blBenefitTitle" />
                        <Text text="{i18n>benefitWhatsappText}" class="blBenefitText" />
                    </VBox>
                </HBox>
                <HBox alignItems="Center" class="blBenefit">
                    <core:Icon src="sap-icon://retail-store" class="blBenefitIcon" />
                    <VBox>
                        <Text text="{i18n>benefitPickupTitle}" class="blBenefitTitle" />
                        <Text text="{i18n>benefitPickupText}" class="blBenefitText" />
                    </VBox>
                </HBox>
                <HBox alignItems="Center" class="blBenefit">
                    <core:Icon src="sap-icon://cart-approval" class="blBenefitIcon" />
                    <VBox>
                        <Text text="{i18n>benefitReserveTitle}" class="blBenefitTitle" />
                        <Text text="{i18n>benefitReserveText}" class="blBenefitText" />
                    </VBox>
                </HBox>
                <HBox alignItems="Center" class="blBenefit">
                    <core:Icon src="sap-icon://lead" class="blBenefitIcon" />
                    <VBox>
                        <Text text="{i18n>benefitPromotionsTitle}" class="blBenefitTitle" />
                        <Text text="{i18n>benefitPromotionsText}" class="blBenefitText" />
                    </VBox>
                </HBox>
            </FlexBox>

            <VBox id="productsSection" class="blContainer">
                <Title
                    text="{= ${catalogView>/categoryName} || ${i18n>sectionProducts} }"
                    level="H2"
                    wrapping="true"
                    class="blSectionTitle"
                />

                <ScrollContainer horizontal="true" vertical="false" width="100%" class="blCategoryNav">
                    <HBox justifyContent="Center" class="blCategoryNavItems">
                        <Button
                            text="{i18n>allCategories}"
                            type="{= ${catalogView>/categoryId} === '' ? 'Emphasized' : 'Transparent' }"
                            press=".onCategoryPress"
                            class="blCategoryItem"
                        />
                        <HBox items="{path: 'catalog>/Categories', sorter: {path: 'Name'}, templateShareable: false}">
                            <Button
                                text="{catalog>Name}"
                                type="{= ${catalogView>/categoryId} === ${catalog>ID} ? 'Emphasized' : 'Transparent' }"
                                press=".onCategoryPress"
                                class="blCategoryItem"
                            />
                        </HBox>
                    </HBox>
                </ScrollContainer>

                <SearchField
                    id="searchField"
                    placeholder="{i18n>searchPlaceholder}"
                    search=".onSearch"
                    class="blSearch"
                />

                <f:GridList
                    id="productGrid"
                    growing="true"
                    growingThreshold="24"
                    noDataText="{i18n>noProducts}"
                    class="blProductGrid"
                    items="{
                        path: 'catalog>/Products',
                        parameters: {
                            $expand: 'Images($select=ID,SortOrder),Variants($select=ID,Stock)',
                            $orderby: 'Featured desc,Name'
                        }
                    }"
                >
                    <f:customLayout>
                        <grid:GridBoxLayout boxMinWidth="15rem" />
                    </f:customLayout>
                    <f:GridListItem type="Active" press=".onProductPress" class="blProductCard">
                        <VBox>
                            <VBox class="blProductImageWrapper">
                                <Image
                                    src="{path: 'catalog>Images', targetType: 'any', formatter: '.formatter.coverImageUrl'}"
                                    alt="{catalog>Name}"
                                    width="100%"
                                    densityAware="false"
                                    class="blProductImage"
                                />
                                <Text
                                    text="{i18n>featured}"
                                    visible="{= ${catalog>Featured} === true }"
                                    class="blFeaturedTag"
                                />
                                <Text
                                    text="{i18n>soldOut}"
                                    visible="{path: 'catalog>Variants', targetType: 'any', formatter: '.formatter.isSoldOut'}"
                                    class="blSoldOutTag"
                                />
                            </VBox>
                            <VBox alignItems="Center" class="blProductInfo">
                                <Text text="{catalog>Name}" maxLines="2" textAlign="Center" class="blProductName" />
                                <Text text="{path: 'catalog>Price', targetType: 'any', formatter: '.formatter.currency'}" class="blProductPrice" />
                            </VBox>
                        </VBox>
                    </f:GridListItem>
                </f:GridList>
            </VBox>

            <core:Fragment fragmentName="apps.dflc.benditalook.view.fragments.StoreFooter" type="XML" />
        </content>
    </Page>
</mvc:View>
