<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Bar class="blHeader">
        <contentLeft>
            <Button
                id="headerBack"
                icon="sap-icon://nav-back"
                type="Transparent"
                tooltip="{i18n>back}"
                press=".onNavBack"
                class="blHeaderAction"
            />
        </contentLeft>
        <contentMiddle>
            <Image
                src="img/logo.webp"
                alt="{i18n>appTitle}"
                tooltip="{i18n>appTitle}"
                densityAware="false"
                press=".onGoHome"
                class="blHeaderLogo"
            />
        </contentMiddle>
        <contentRight>
            <Button
                icon="sap-icon://discussion"
                text="{i18n>headerService}"
                type="Transparent"
                tooltip="{i18n>talkOnWhatsapp}"
                visible="{= !!${store>/Whatsapp} }"
                press=".onContactWhatsapp"
                class="blHeaderAction blHeaderService"
            />
            <Button
                icon="sap-icon://cart"
                text="{i18n>cart}"
                type="Transparent"
                tooltip="{i18n>cart}"
                press=".onOpenCart"
                class="blHeaderAction blCartButton"
            >
                <customData>
                    <BadgeCustomData
                        key="badge"
                        value="{cart>/count}"
                        visible="{= ${cart>/count} > 0 }"
                    />
                </customData>
            </Button>
        </contentRight>
    </Bar>
</core:FragmentDefinition>
