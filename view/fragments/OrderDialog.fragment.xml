<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>
    <Dialog
        id="orderDialog"
        title="{parts: ['i18n>orderNumber', 'Number'], formatter: '.formatter.message'}"
        contentWidth="40rem"
        resizable="true"
        draggable="true"
        class="blDialog"
    >
        <content>
            <VBox class="sapUiSmallMargin">
                <HBox justifyContent="SpaceBetween" alignItems="Center">
                    <ObjectStatus
                        text="{path: 'Status', formatter: '.formatStatus'}"
                        state="{path: 'Status', formatter: '.formatter.statusState'}"
                        inverted="true"
                    />
                    <Text text="{path: 'createdAt', targetType: 'any', formatter: '.formatter.dateTime'}" class="blMuted" />
                </HBox>
                <HBox class="sapUiTinyMarginTop">
                    <ObjectStatus text="{path: 'Channel', formatter: '.formatChannel'}" icon="sap-icon://retail-store" class="sapUiSmallMarginEnd" />
                    <ObjectStatus text="{path: 'FulfillmentType', formatter: '.formatFulfillment'}" icon="sap-icon://shipping-status" />
                </HBox>

                <FlexBox
                    wrap="Wrap"
                    visible="{= ${path: 'Status', targetType: 'any'} !== 'COMPLETED' &amp;&amp; ${path: 'Status', targetType: 'any'} !== 'CANCELLED' }"
                    class="blOrderActions"
                >
                    <Button
                        text="{i18n>startService}"
                        type="Emphasized"
                        visible="{= ${path: 'Status', targetType: 'any'} === 'NEW' }"
                        press=".orders.onStartService"
                    />
                    <Button
                        text="{i18n>outForDelivery}"
                        type="Emphasized"
                        visible="{= ${path: 'Status', targetType: 'any'} === 'IN_SERVICE' &amp;&amp; ${path: 'FulfillmentType', targetType: 'any'} === 'DELIVERY' }"
                        press=".orders.onOpenDeliveryDialog"
                    />
                    <Button
                        text="{i18n>completeOrder}"
                        type="Emphasized"
                        visible="{= ${path: 'Status', targetType: 'any'} === 'IN_SERVICE' || ${path: 'Status', targetType: 'any'} === 'OUT_FOR_DELIVERY' }"
                        press=".orders.onComplete"
                    />
                    <Button
                        text="{i18n>cancelOrder}"
                        type="Reject"
                        visible="{= ${path: 'Status', targetType: 'any'} === 'NEW' || ${path: 'Status', targetType: 'any'} === 'IN_SERVICE' || ${path: 'Status', targetType: 'any'} === 'OUT_FOR_DELIVERY' }"
                        press=".orders.onCancel"
                    />
                </FlexBox>

                <form:SimpleForm editable="false" layout="ColumnLayout" title="{i18n>contactTitle}">
                    <Label text="{i18n>customerName}" />
                    <Text text="{CustomerName}" />
                    <Label text="{i18n>customerPhone}" />
                    <Text text="{CustomerPhone}" />
                    <Label text="{i18n>customerEmail}" />
                    <Link text="{CustomerEmail}" href="{= 'mailto:' + ${path: 'CustomerEmail', targetType: 'any'} }" />
                    <Label text="{i18n>address}" visible="{= ${path: 'FulfillmentType', targetType: 'any'} === 'DELIVERY' }" />
                    <Text
                        text="{parts: ['Address', 'AddressNumber', 'Complement', 'District', 'City', 'State', 'ZipCode'], formatter: '.formatter.fullAddress'}"
                        visible="{= ${path: 'FulfillmentType', targetType: 'any'} === 'DELIVERY' }"
                    />
                    <Label text="{i18n>notes}" />
                    <Text text="{Notes}" />
                </form:SimpleForm>

                <form:SimpleForm
                    editable="false"
                    layout="ColumnLayout"
                    title="{i18n>deliveryTitle}"
                    visible="{= !!${path: 'DeliveryType', targetType: 'any'} }"
                >
                    <Label text="{i18n>deliveryType}" />
                    <Text text="{path: 'DeliveryType', formatter: '.formatDeliveryType'}" />
                    <Label
                        text="{= ${path: 'DeliveryType', targetType: 'any'} === 'CUSTOMER_ARRANGED' ? ${i18n>pickedUpBy} : ${i18n>courierName} }"
                        visible="{= !!${path: 'CourierName', targetType: 'any'} }"
                    />
                    <Text text="{CourierName}" visible="{= !!${path: 'CourierName', targetType: 'any'} }" />
                    <Label text="{i18n>vehiclePlate}" visible="{= !!${path: 'VehiclePlate', targetType: 'any'} }" />
                    <Text text="{VehiclePlate}" visible="{= !!${path: 'VehiclePlate', targetType: 'any'} }" />
                    <Label text="{i18n>deliveryNotes}" visible="{= !!${path: 'DeliveryNotes', targetType: 'any'} }" />
                    <Text text="{DeliveryNotes}" visible="{= !!${path: 'DeliveryNotes', targetType: 'any'} }" />
                </form:SimpleForm>

                <Table items="{path: 'Items', templateShareable: false}" popinLayout="GridSmall" class="blTable sapUiSmallMarginTop">
                    <columns>
                        <Column>
                            <Text text="{i18n>product}" />
                        </Column>
                        <Column hAlign="Center" width="7rem" minScreenWidth="Tablet" demandPopin="true">
                            <Text text="{i18n>quantity}" />
                        </Column>
                        <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                            <Text text="{i18n>total}" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem type="{= ${Product_ID} ? 'Navigation' : 'Inactive' }" press=".orders.onItemPress">
                            <cells>
                                <HBox alignItems="Center">
                                    <Image
                                        src="{path: 'ImageId', formatter: '.formatter.catalogImageUrl'}"
                                        width="3rem"
                                        height="4rem"
                                        densityAware="false"
                                        class="blCartImage sapUiSmallMarginEnd"
                                    />
                                    <Text text="{parts: ['ProductName', 'ColorName', 'Size'], formatter: '.formatter.variantDescription'}" />
                                </HBox>
                                <Text text="{Quantity}" />
                                <Text text="{path: 'TotalPrice', targetType: 'any', formatter: '.formatter.currency'}" class="blNoWrap" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <List
                    items="{path: 'Promotions', templateShareable: false}"
                    headerText="{i18n>appliedPromotions}"
                    showSeparators="None"
                    noDataText="{i18n>noPromotionsApplied}"
                    class="blPromotionList sapUiSmallMarginTop"
                >
                    <StandardListItem
                        icon="{= ${path: 'RewardType', targetType: 'any'} === 'GIFT' ? 'sap-icon://gift' : 'sap-icon://lead' }"
                        title="{PromotionName}"
                        description="{parts: ['GiftDescription', 'CouponCode'], formatter: '.formatter.variantDescription'}"
                        info="{path: 'DiscountAmount', targetType: 'any', formatter: '.formatter.negativeAmount'}"
                        infoState="Success"
                    />
                </List>

                <HBox justifyContent="End" alignItems="Center" visible="{= ${path: 'DiscountAmount', targetType: 'any'} > 0 }">
                    <Text text="{i18n>subtotal}" class="sapUiSmallMarginEnd" />
                    <Text text="{path: 'SubtotalAmount', targetType: 'any', formatter: '.formatter.currency'}" />
                </HBox>
                <HBox justifyContent="End" alignItems="Center" visible="{= ${path: 'DiscountAmount', targetType: 'any'} > 0 }">
                    <Text text="{i18n>discount}" class="sapUiSmallMarginEnd" />
                    <ObjectStatus text="{path: 'DiscountAmount', targetType: 'any', formatter: '.formatter.negativeAmount'}" state="Success" />
                </HBox>
                <HBox justifyContent="End" alignItems="Center" class="blCartTotal">
                    <Text text="{i18n>total}" class="sapUiSmallMarginEnd" />
                    <Text text="{path: 'TotalAmount', targetType: 'any', formatter: '.formatter.currency'}" class="blDetailPrice" />
                </HBox>
            </VBox>
        </content>
        <buttons>
            <Button text="{i18n>whatsapp}" icon="sap-icon://discussion" type="Success" press=".orders.onWhatsapp" visible="{= !!${path: 'CustomerPhone', targetType: 'any'} }" />
            <Button text="{i18n>close}" press=".orders.onCloseDialog" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
