<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>
    <Dialog
        id="deliveryDialog"
        title="{i18n>deliveryDialogTitle}"
        contentWidth="28rem"
        class="blDialog"
    >
        <content>
            <form:SimpleForm editable="true" layout="ColumnLayout">
                <Label text="{i18n>deliveryType}" required="true" />
                <Select selectedKey="{delivery>/DeliveryType}" width="100%">
                    <core:Item key="UBER_FLASH" text="{i18n>deliveryType.UBER_FLASH}" />
                    <core:Item key="LOCAL_COURIER" text="{i18n>deliveryType.LOCAL_COURIER}" />
                    <core:Item key="CUSTOMER_ARRANGED" text="{i18n>deliveryType.CUSTOMER_ARRANGED}" />
                </Select>
                <Label text="" visible="{= ${delivery>/DeliveryType} === 'CUSTOMER_ARRANGED' }" />
                <Text text="{i18n>customerArrangedInfo}" visible="{= ${delivery>/DeliveryType} === 'CUSTOMER_ARRANGED' }" class="blMuted" />
                <Label
                    text="{= ${delivery>/DeliveryType} === 'CUSTOMER_ARRANGED' ? ${i18n>pickedUpBy} : ${i18n>courierName} }"
                    required="{= ${delivery>/DeliveryType} !== 'CUSTOMER_ARRANGED' }"
                />
                <Input value="{delivery>/CourierName}" maxLength="120" />
                <Label text="{i18n>vehiclePlate}" required="{= ${delivery>/DeliveryType} === 'UBER_FLASH' }" />
                <Input value="{delivery>/VehiclePlate}" maxLength="10" placeholder="{i18n>vehiclePlatePlaceholder}" />
                <Label text="{i18n>deliveryNotes}" />
                <TextArea value="{delivery>/DeliveryNotes}" maxLength="255" rows="3" placeholder="{i18n>deliveryNotesPlaceholder}" />
            </form:SimpleForm>
        </content>
        <buttons>
            <Button text="{i18n>confirmDelivery}" type="Emphasized" press=".orders.onConfirmDelivery" />
            <Button text="{i18n>cancel}" press=".orders.onCloseDeliveryDialog" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
