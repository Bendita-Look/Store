<mvc:View
    controllerName="apps.dflc.benditalook.controller.Admin"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
    xmlns:form="sap.ui.layout.form"
>
    <Page id="adminPage" class="blPage">
        <customHeader>
            <Bar class="blHeader blAdminHeader">
                <contentLeft>
                    <HBox alignItems="Center" class="blBrand">
                        <Image src="img/logo.jpg" width="2rem" height="2rem" decorative="true" class="sapUiTinyMarginEnd" />
                        <Title text="{i18n>adminTitle}" class="blBrandTitle" />
                    </HBox>
                </contentLeft>
                <contentRight>
                    <Text
                        text="{= ${adminView>/userName} || ${i18n>administrator} }"
                        tooltip="{= ${adminView>/userName} || ${i18n>administrator} }"
                        class="blMuted blAdminUser"
                    />
                    <Button icon="sap-icon://retail-store" tooltip="{i18n>openStore}" type="Transparent" press=".onOpenStore" />
                    <Button icon="sap-icon://log" tooltip="{i18n>logout}" type="Transparent" press=".onLogout" />
                </contentRight>
            </Bar>
        </customHeader>
        <content>
            <IconTabBar
                id="adminTabs"
                selectedKey="{adminView>/tab}"
                select=".onTabSelect"
                expandable="false"
                stretchContentHeight="false"
                class="blTabs"
            >
                <items>
                    <IconTabFilter key="orders" icon="sap-icon://sales-order" text="{i18n>ordersTab}">
                        <FlexBox wrap="Wrap" alignItems="Center" class="blOrdersToolbar">
                            <ScrollContainer horizontal="true" vertical="false" width="100%" class="blStatusFilterScroll">
                                <HBox class="blCategoryNavItems blStatusFilter">
                                    <Button
                                        text="{i18n>allOrders}"
                                        type="{= ${ordersFilter>/status} === 'ALL' ? 'Emphasized' : 'Transparent' }"
                                        press=".orders.onStatusPress"
                                        class="blCategoryItem"
                                    >
                                        <customData>
                                            <core:CustomData key="status" value="ALL" />
                                        </customData>
                                    </Button>
                                    <Button
                                        text="{i18n>orderStatus.NEW}"
                                        type="{= ${ordersFilter>/status} === 'NEW' ? 'Emphasized' : 'Transparent' }"
                                        press=".orders.onStatusPress"
                                        class="blCategoryItem"
                                    >
                                        <customData>
                                            <core:CustomData key="status" value="NEW" />
                                        </customData>
                                    </Button>
                                    <Button
                                        text="{i18n>orderStatus.IN_SERVICE}"
                                        type="{= ${ordersFilter>/status} === 'IN_SERVICE' ? 'Emphasized' : 'Transparent' }"
                                        press=".orders.onStatusPress"
                                        class="blCategoryItem"
                                    >
                                        <customData>
                                            <core:CustomData key="status" value="IN_SERVICE" />
                                        </customData>
                                    </Button>
                                    <Button
                                        text="{i18n>orderStatus.OUT_FOR_DELIVERY}"
                                        type="{= ${ordersFilter>/status} === 'OUT_FOR_DELIVERY' ? 'Emphasized' : 'Transparent' }"
                                        press=".orders.onStatusPress"
                                        class="blCategoryItem"
                                    >
                                        <customData>
                                            <core:CustomData key="status" value="OUT_FOR_DELIVERY" />
                                        </customData>
                                    </Button>
                                    <Button
                                        text="{i18n>orderStatus.COMPLETED}"
                                        type="{= ${ordersFilter>/status} === 'COMPLETED' ? 'Emphasized' : 'Transparent' }"
                                        press=".orders.onStatusPress"
                                        class="blCategoryItem"
                                    >
                                        <customData>
                                            <core:CustomData key="status" value="COMPLETED" />
                                        </customData>
                                    </Button>
                                    <Button
                                        text="{i18n>orderStatus.CANCELLED}"
                                        type="{= ${ordersFilter>/status} === 'CANCELLED' ? 'Emphasized' : 'Transparent' }"
                                        press=".orders.onStatusPress"
                                        class="blCategoryItem"
                                    >
                                        <customData>
                                            <core:CustomData key="status" value="CANCELLED" />
                                        </customData>
                                    </Button>
                                </HBox>
                            </ScrollContainer>
                            <HBox alignItems="Center" class="blOrdersActions">
                                <Button text="{i18n>registerStoreSale}" icon="sap-icon://cart-approval" type="Emphasized" press=".storeSale.onOpenStoreSale" />
                                <Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" press=".orders.onRefresh" />
                            </HBox>
                        </FlexBox>
                        <Table
                            id="ordersTable"
                            popinLayout="GridSmall"
                            growing="true"
                            growingThreshold="30"
                            noDataText="{i18n>noOrders}"
                            class="blTable"
                            items="{path: '/Orders', parameters: {$orderby: 'Number desc'}}"
                        >
                            <columns>
                                <Column width="4.5rem">
                                    <Text text="{i18n>orderColumnNumber}" />
                                </Column>
                                <Column>
                                    <Text text="{i18n>customer}" />
                                </Column>
                                <Column minScreenWidth="Tablet" demandPopin="true">
                                    <Text text="{i18n>channel}" />
                                </Column>
                                <Column minScreenWidth="Tablet" demandPopin="true">
                                    <Text text="{i18n>date}" />
                                </Column>
                                <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                                    <Text text="{i18n>total}" />
                                </Column>
                                <Column hAlign="Center">
                                    <Text text="{i18n>status}" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem type="Navigation" press=".orders.onOrderPress">
                                    <cells>
                                        <ObjectIdentifier title="{= '#' + ${path: 'Number', targetType: 'any'} }" />
                                        <ObjectIdentifier
                                            title="{parts: ['CustomerName', 'i18n>storeCustomer'], formatter: '.formatter.firstText'}"
                                            text="{CustomerPhone}"
                                        />
                                        <VBox>
                                            <Text text="{path: 'Channel', formatter: '.formatChannel'}" />
                                            <Text text="{path: 'FulfillmentType', formatter: '.formatFulfillment'}" class="blMuted" />
                                        </VBox>
                                        <Text text="{path: 'createdAt', targetType: 'any', formatter: '.formatter.dateTime'}" />
                                        <Text text="{path: 'TotalAmount', targetType: 'any', formatter: '.formatter.currency'}" />
                                        <ObjectStatus
                                            text="{path: 'Status', formatter: '.formatStatus'}"
                                            state="{path: 'Status', formatter: '.formatter.statusState'}"
                                            inverted="true"
                                        />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>

                    <IconTabFilter key="products" icon="sap-icon://product" text="{i18n>productsTab}">
                        <Toolbar style="Clear">
                            <ToolbarSpacer />
                            <Button text="{i18n>newProduct}" icon="sap-icon://add" type="Emphasized" press=".products.onNewProduct" />
                        </Toolbar>
                        <Table
                            id="productsTable"
                            popinLayout="GridSmall"
                            growing="true"
                            growingThreshold="30"
                            noDataText="{i18n>noProducts}"
                            class="blTable"
                            items="{
                                path: '/Products',
                                parameters: {
                                    $filter: 'IsActiveEntity eq false or SiblingEntity/IsActiveEntity eq null',
                                    $expand: 'Category($select=Name),Variants($select=ID,Stock),Images($select=ID,SortOrder)',
                                    $orderby: 'Name'
                                }
                            }"
                        >
                            <columns>
                                <Column width="4.5rem">
                                    <Text text="{i18n>photo}" />
                                </Column>
                                <Column>
                                    <Text text="{i18n>productName}" />
                                </Column>
                                <Column minScreenWidth="Tablet" demandPopin="true">
                                    <Text text="{i18n>category}" />
                                </Column>
                                <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                                    <Text text="{i18n>price}" />
                                </Column>
                                <Column hAlign="Center" minScreenWidth="Tablet" demandPopin="true">
                                    <Text text="{i18n>stock}" />
                                </Column>
                                <Column hAlign="Center" minScreenWidth="Tablet" demandPopin="true">
                                    <Text text="{i18n>status}" />
                                </Column>
                                <Column width="3rem" />
                            </columns>
                            <items>
                                <ColumnListItem type="Navigation" press=".products.onProductPress">
                                    <cells>
                                        <Image
                                            src="{path: 'Images', targetType: 'any', formatter: '.formatter.coverImageUrl'}"
                                            width="2.75rem"
                                            height="3.5rem"
                                            densityAware="false"
                                            class="blThumb"
                                        />
                                        <ObjectIdentifier title="{Name}" text="{= ${path: 'IsActiveEntity', targetType: 'any'} ? '' : ${i18n>draft} }" />
                                        <Text text="{Category/Name}" />
                                        <Text text="{path: 'Price', targetType: 'any', formatter: '.formatter.currency'}" />
                                        <Text text="{path: 'Variants', targetType: 'any', formatter: '.formatter.totalStock'}" />
                                        <ObjectStatus
                                            text="{= ${path: 'Active', targetType: 'any'} ? ${i18n>active} : ${i18n>inactive} }"
                                            state="{= ${path: 'Active', targetType: 'any'} ? 'Success' : 'None' }"
                                        />
                                        <Button icon="sap-icon://delete" type="Transparent" tooltip="{i18n>delete}" press=".products.onDeleteProduct" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>

                    <IconTabFilter key="categories" icon="sap-icon://tags" text="{i18n>categoriesTab}">
                        <Toolbar style="Clear">
                            <ToolbarSpacer />
                            <Button text="{i18n>newCategory}" icon="sap-icon://add" type="Emphasized" press=".categories.onNewCategory" />
                        </Toolbar>
                        <Table
                            id="categoriesTable"
                            popinLayout="GridSmall"
                            noDataText="{i18n>noCategories}"
                            class="blTable"
                            items="{
                                path: '/Categories',
                                parameters: {
                                    $filter: 'IsActiveEntity eq false or SiblingEntity/IsActiveEntity eq null',
                                    $orderby: 'Name'
                                }
                            }"
                        >
                            <columns>
                                <Column>
                                    <Text text="{i18n>categoryName}" />
                                </Column>
                                <Column minScreenWidth="Tablet" demandPopin="true">
                                    <Text text="{i18n>description}" />
                                </Column>
                                <Column hAlign="Center" minScreenWidth="Tablet" demandPopin="true">
                                    <Text text="{i18n>status}" />
                                </Column>
                                <Column width="6rem" />
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <ObjectIdentifier title="{Name}" text="{= ${path: 'IsActiveEntity', targetType: 'any'} ? '' : ${i18n>draft} }" />
                                        <Text text="{Description}" />
                                        <ObjectStatus
                                            text="{= ${path: 'Active', targetType: 'any'} ? ${i18n>active} : ${i18n>inactive} }"
                                            state="{= ${path: 'Active', targetType: 'any'} ? 'Success' : 'None' }"
                                        />
                                        <HBox justifyContent="End">
                                            <Button icon="sap-icon://edit" type="Transparent" tooltip="{i18n>edit}" press=".categories.onEditCategory" />
                                            <Button icon="sap-icon://delete" type="Transparent" tooltip="{i18n>delete}" press=".categories.onDeleteCategory" />
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>

                    <IconTabFilter key="promotions" icon="sap-icon://lead" text="{i18n>promotionsTab}">
                        <Toolbar style="Clear">
                            <ToolbarSpacer />
                            <Button text="{i18n>newPromotion}" icon="sap-icon://add" type="Emphasized" press=".promotions.onNewPromotion" />
                        </Toolbar>
                        <Table
                            id="promotionsTable"
                            popinLayout="GridSmall"
                            noDataText="{i18n>noPromotions}"
                            class="blTable"
                            items="{
                                path: '/Promotions',
                                parameters: {
                                    $filter: 'IsActiveEntity eq false or SiblingEntity/IsActiveEntity eq null',
                                    $orderby: 'Name'
                                }
                            }"
                        >
                            <columns>
                                <Column>
                                    <Text text="{i18n>promotionName}" />
                                </Column>
                                <Column minScreenWidth="Tablet" demandPopin="true">
                                    <Text text="{i18n>rewardType}" />
                                </Column>
                                <Column minScreenWidth="Tablet" demandPopin="true">
                                    <Text text="{i18n>couponCode}" />
                                </Column>
                                <Column minScreenWidth="Desktop" demandPopin="true">
                                    <Text text="{i18n>period}" />
                                </Column>
                                <Column hAlign="Center">
                                    <Text text="{i18n>status}" />
                                </Column>
                                <Column width="6rem" />
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <ObjectIdentifier title="{Name}" text="{= ${path: 'IsActiveEntity', targetType: 'any'} ? ${Description} : ${i18n>draft} }" />
                                        <Text text="{parts: ['RewardType', {path: 'RewardValue', targetType: 'any'}, 'GiftDescription', {path: 'MaxDiscount', targetType: 'any'}], formatter: '.formatReward'}" />
                                        <Text text="{parts: ['CouponCode', {path: 'UsedCount', targetType: 'any'}, {path: 'MaxUses', targetType: 'any'}], formatter: '.formatCouponUsage'}" />
                                        <Text text="{parts: [{path: 'StartDate', targetType: 'any'}, {path: 'EndDate', targetType: 'any'}], formatter: '.formatPeriod'}" />
                                        <ObjectStatus
                                            text="{= ${path: 'Active', targetType: 'any'} ? ${i18n>active} : ${i18n>inactive} }"
                                            state="{= ${path: 'Active', targetType: 'any'} ? 'Success' : 'None' }"
                                        />
                                        <HBox justifyContent="End">
                                            <Button icon="sap-icon://edit" type="Transparent" tooltip="{i18n>edit}" press=".promotions.onEditPromotion" />
                                            <Button icon="sap-icon://delete" type="Transparent" tooltip="{i18n>delete}" press=".promotions.onDeletePromotion" />
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>

                    <IconTabFilter key="reports" icon="sap-icon://line-chart" text="{i18n>reportsTab}">
                        <Toolbar style="Clear">
                            <Label text="{i18n>reportYear}" class="sapUiTinyMarginEnd" />
                            <Select selectedKey="{report>/year}" items="{report>/years}" change=".reports.onYearChange" width="8rem">
                                <core:Item key="{report>key}" text="{report>key}" />
                            </Select>
                            <ToolbarSpacer />
                            <Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" press=".reports.onRefresh" />
                        </Toolbar>

                        <FlexBox wrap="Wrap" class="blKpis" visible="{report>/loaded}">
                            <VBox class="blKpi">
                                <Text text="{i18n>kpiRevenue}" class="blKpiLabel" />
                                <Text text="{path: 'report>/summary/Revenue', formatter: '.formatter.currency'}" class="blKpiValue" />
                            </VBox>
                            <VBox class="blKpi">
                                <Text text="{i18n>kpiCompletedOrders}" class="blKpiLabel" />
                                <Text text="{report>/summary/CompletedOrders}" class="blKpiValue" />
                            </VBox>
                            <VBox class="blKpi">
                                <Text text="{i18n>kpiItemsSold}" class="blKpiLabel" />
                                <Text text="{report>/summary/ItemsSold}" class="blKpiValue" />
                            </VBox>
                            <VBox class="blKpi">
                                <Text text="{i18n>kpiAverageTicket}" class="blKpiLabel" />
                                <Text text="{path: 'report>/summary/AverageTicket', formatter: '.formatter.currency'}" class="blKpiValue" />
                            </VBox>
                            <VBox class="blKpi">
                                <Text text="{i18n>kpiOpenOrders}" class="blKpiLabel" />
                                <Text text="{report>/summary/OpenOrders}" class="blKpiValue" />
                                <Text text="{path: 'report>/summary/OpenAmount', formatter: '.formatter.currency'}" class="blMuted" />
                            </VBox>
                            <VBox class="blKpi">
                                <Text text="{i18n>kpiCancelledOrders}" class="blKpiLabel" />
                                <Text text="{report>/summary/CancelledOrders}" class="blKpiValue" />
                            </VBox>
                        </FlexBox>

                        <MessageStrip text="{i18n>reportInfo}" type="Information" showIcon="true" class="sapUiSmallMarginTopBottom" />

                        <Table items="{report>/months}" class="blTable" headerText="{i18n>monthlySales}" popinLayout="GridSmall">
                            <columns>
                                <Column>
                                    <Text text="{i18n>month}" />
                                </Column>
                                <Column hAlign="Center" minScreenWidth="Tablet" demandPopin="true">
                                    <Text text="{i18n>ordersTab}" />
                                </Column>
                                <Column hAlign="Center" minScreenWidth="Tablet" demandPopin="true">
                                    <Text text="{i18n>kpiItemsSold}" />
                                </Column>
                                <Column hAlign="End">
                                    <Text text="{i18n>kpiRevenue}" />
                                </Column>
                                <Column minScreenWidth="Tablet" demandPopin="true">
                                    <Text text="{i18n>monthShare}" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{report>month}" />
                                        <Text text="{report>orders}" />
                                        <Text text="{report>items}" />
                                        <Text text="{path: 'report>revenue', formatter: '.formatter.currency'}" />
                                        <ProgressIndicator
                                            percentValue="{report>share}"
                                            displayValue="{= ${report>share} + '%' }"
                                            showValue="true"
                                            height="1.25rem"
                                            width="100%"
                                            class="blBar"
                                        />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>

                        <Table
                            items="{report>/topProducts}"
                            class="blTable sapUiMediumMarginTop"
                            headerText="{i18n>topProducts}"
                            noDataText="{i18n>noSalesInYear}"
                            popinLayout="GridSmall"
                        >
                            <columns>
                                <Column>
                                    <Text text="{i18n>product}" />
                                </Column>
                                <Column hAlign="Center" minScreenWidth="Tablet" demandPopin="true">
                                    <Text text="{i18n>kpiItemsSold}" />
                                </Column>
                                <Column hAlign="End">
                                    <Text text="{i18n>kpiRevenue}" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{report>ProductName}" />
                                        <Text text="{report>Quantity}" />
                                        <Text text="{path: 'report>Revenue', formatter: '.formatter.currency'}" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>

                    <IconTabFilter key="settings" icon="sap-icon://action-settings" text="{i18n>settingsTab}">
                        <VBox class="blContainer">
                            <MessageStrip text="{i18n>settingsInfo}" type="Information" showIcon="true" class="sapUiSmallMarginBottom" />
                            <form:SimpleForm
                                id="settingsForm"
                                editable="true"
                                layout="ColumnLayout"
                                columnsM="2"
                                columnsL="2"
                                columnsXL="2"
                                title="{i18n>storeData}"
                                visible="{settings>/loaded}"
                                class="blForm"
                            >
                                <Label text="{i18n>storeName}" required="true" />
                                <Input value="{StoreName}" maxLength="80" editable="{settings>/editing}" />
                                <Label text="{i18n>storeWhatsapp}" />
                                <Input value="{Whatsapp}" maxLength="20" type="Tel" placeholder="{i18n>storeWhatsappPlaceholder}" editable="{settings>/editing}" />
                                <Label text="{i18n>storeEmail}" />
                                <Input value="{ContactEmail}" maxLength="120" type="Email" editable="{settings>/editing}" />
                                <Label text="{i18n>storeInstagram}" />
                                <Input value="{Instagram}" maxLength="60" placeholder="{i18n>storeInstagramPlaceholder}" editable="{settings>/editing}" />
                                <Label text="{i18n>pickupAddress}" />
                                <TextArea
                                    value="{PickupAddress}"
                                    maxLength="255"
                                    rows="2"
                                    placeholder="{i18n>pickupAddressPlaceholder}"
                                    editable="{settings>/editing}"
                                />
                                <Label text="{i18n>storeUrl}" />
                                <Input value="{StoreUrl}" maxLength="255" placeholder="{i18n>storeUrlPlaceholder}" editable="{settings>/editing}" />
                                <Label text="{i18n>notificationEmails}" />
                                <TextArea
                                    value="{NotificationEmails}"
                                    maxLength="500"
                                    rows="2"
                                    placeholder="{i18n>notificationEmailsPlaceholder}"
                                    editable="{settings>/editing}"
                                />
                            </form:SimpleForm>
                            <VBox visible="{settings>/loaded}" class="blBannerEditor">
                                <Title text="{i18n>bannerTitle}" level="H3" />
                                <Text text="{i18n>bannerHint}" class="blMuted" />
                                <Image
                                    src="{settings>/bannerPreview}"
                                    visible="{= !!${settings>/bannerPreview} }"
                                    alt="{i18n>bannerTitle}"
                                    densityAware="false"
                                    class="blBannerPreview"
                                />
                                <Text text="{i18n>bannerEmpty}" visible="{= !${settings>/bannerPreview} }" class="blMuted" />
                                <HBox wrap="Wrap" alignItems="Center" visible="{settings>/editing}" class="blBannerActions">
                                    <unified:FileUploader
                                        buttonOnly="true"
                                        buttonText="{i18n>bannerUpload}"
                                        icon="sap-icon://upload"
                                        fileType="jpg,jpeg,png,webp"
                                        mimeType="image/jpeg,image/png,image/webp"
                                        change=".settings.onBannerSelected"
                                    />
                                    <Button
                                        text="{i18n>bannerRemove}"
                                        icon="sap-icon://delete"
                                        type="Transparent"
                                        visible="{= !!${settings>/bannerPreview} }"
                                        press=".settings.onRemoveBanner"
                                    />
                                </HBox>
                                <Text text="{i18n>bannerEditHint}" visible="{= !${settings>/editing} }" class="blMuted" />
                            </VBox>
                            <HBox justifyContent="End" class="sapUiSmallMarginTop">
                                <Button
                                    text="{i18n>edit}"
                                    icon="sap-icon://edit"
                                    type="Emphasized"
                                    visible="{= ${settings>/loaded} &amp;&amp; !${settings>/editing} }"
                                    press=".settings.onEdit"
                                />
                                <Button
                                    text="{i18n>cancel}"
                                    visible="{settings>/editing}"
                                    press=".settings.onCancel"
                                    class="sapUiSmallMarginEnd"
                                />
                                <Button
                                    text="{i18n>save}"
                                    icon="sap-icon://save"
                                    type="Emphasized"
                                    visible="{settings>/editing}"
                                    press=".settings.onSave"
                                />
                            </HBox>
                        </VBox>
                    </IconTabFilter>

                    <IconTabFilter key="backup" icon="sap-icon://database" text="{i18n>backupTab}">
                        <VBox class="blContainer">
                            <MessageStrip text="{i18n>backupInfo}" type="Information" showIcon="true" class="sapUiSmallMarginBottom" />
                            <HBox wrap="Wrap">
                                <Button
                                    text="{i18n>exportBackup}"
                                    icon="sap-icon://download"
                                    type="Emphasized"
                                    press=".backup.onExport"
                                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                                />
                                <unified:FileUploader
                                    buttonOnly="true"
                                    buttonText="{i18n>importBackup}"
                                    icon="sap-icon://upload"
                                    fileType="zip"
                                    sendXHR="true"
                                    change=".backup.onImportFileChange"
                                />
                            </HBox>
                        </VBox>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>
