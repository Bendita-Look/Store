<mvc:View
    controllerName="apps.dflc.benditalook.controller.OrderTracking"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Page id="orderTrackingPage" class="blPage">
        <customHeader>
            <core:Fragment fragmentName="apps.dflc.benditalook.view.fragments.StoreHeader" type="XML" />
        </customHeader>
        <content>
            <VBox visible="{tracking>/loaded}" class="blContainer blTracking">
                <Title
                    text="{parts: ['i18n>orderNumber', 'tracking>/order/Number'], formatter: '.formatter.message'}"
                    level="H1"
                    titleStyle="H2"
                />
                <Text text="{path: 'tracking>/order/createdAt', targetType: 'any', formatter: '.formatter.dateTime'}" class="blMuted" />

                <MessageStrip
                    text="{i18n>orderCancelledInfo}"
                    type="Error"
                    showIcon="true"
                    visible="{tracking>/cancelled}"
                    class="sapUiSmallMarginTop"
                />

                <HBox
                    items="{tracking>/steps}"
                    visible="{= !${tracking>/cancelled} }"
                    justifyContent="SpaceBetween"
                    class="blSteps sapUiMediumMarginTopBottom"
                >
                    <VBox alignItems="Center" class="blStep">
                        <core:Icon
                            src="{tracking>icon}"
                            size="1.75rem"
                            color="{= ${tracking>done} ? '#8e3b5b' : '#c9a3b2' }"
                        />
                        <Text text="{tracking>text}" textAlign="Center" class="sapUiTinyMarginTop" />
                    </VBox>
                </HBox>

                <VBox visible="{tracking>/hasDelivery}" class="blDeliveryCard sapUiSmallMarginBottom">
                    <Title text="{i18n>deliveryTitle}" level="H3" class="sapUiTinyMarginBottom" />
                    <Text text="{parts: ['i18n>deliveryTypeLine', 'tracking>/deliveryTypeText'], formatter: '.formatter.message'}" />
                    <Text text="{parts: ['i18n>courierLine', 'tracking>/order/CourierName'], formatter: '.formatter.message'}" />
                    <Text
                        text="{parts: ['i18n>vehiclePlateLine', 'tracking>/order/VehiclePlate'], formatter: '.formatter.message'}"
                        visible="{= !!${tracking>/order/VehiclePlate} }"
                    />
                    <Text text="{tracking>/order/DeliveryNotes}" visible="{= !!${tracking>/order/DeliveryNotes} }" class="blMuted" />
                </VBox>

                <VBox visible="{tracking>/isPickup}" class="blDeliveryCard sapUiSmallMarginBottom">
                    <Title text="{i18n>fulfillment.PICKUP}" level="H3" class="sapUiTinyMarginBottom" />
                    <Text text="{i18n>pickupTrackingInfo}" />
                    <Text text="{store>/PickupAddress}" visible="{= !!${store>/PickupAddress} }" class="blProductName sapUiTinyMarginTop" />
                </VBox>

                <Text text="{i18n>trackingInfo}" class="sapUiSmallMarginBottom" />

                <Table items="{tracking>/order/Items}" class="blTable">
                    <columns>
                        <Column>
                            <Text text="{i18n>product}" />
                        </Column>
                        <Column hAlign="Center" width="7rem">
                            <Text text="{i18n>quantity}" />
                        </Column>
                        <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                            <Text text="{i18n>unitPrice}" />
                        </Column>
                        <Column hAlign="End">
                            <Text text="{i18n>total}" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem type="{= ${tracking>ProductId} ? 'Navigation' : 'Inactive' }" press=".onItemPress">
                            <cells>
                                <HBox alignItems="Center">
                                    <Image
                                        src="{path: 'tracking>ImageId', formatter: '.formatter.catalogImageUrl'}"
                                        width="3rem"
                                        height="4rem"
                                        densityAware="false"
                                        class="blCartImage sapUiSmallMarginEnd"
                                    />
                                    <Text text="{parts: ['tracking>ProductName', 'tracking>ColorName', 'tracking>Size'], formatter: '.formatter.variantDescription'}" />
                                </HBox>
                                <Text text="{tracking>Quantity}" />
                                <Text text="{path: 'tracking>UnitPrice', targetType: 'any', formatter: '.formatter.currency'}" />
                                <Text text="{path: 'tracking>TotalPrice', targetType: 'any', formatter: '.formatter.currency'}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <List
                    items="{tracking>/order/Promotions}"
                    visible="{= !!${tracking>/order/Promotions} &amp;&amp; ${tracking>/order/Promotions}.length > 0 }"
                    headerText="{i18n>appliedPromotions}"
                    showSeparators="None"
                    class="blPromotionList sapUiSmallMarginTop"
                >
                    <StandardListItem
                        icon="{= ${tracking>RewardType} === 'GIFT' ? 'sap-icon://gift' : 'sap-icon://lead' }"
                        title="{tracking>PromotionName}"
                        description="{tracking>GiftDescription}"
                        info="{path: 'tracking>DiscountAmount', formatter: '.formatter.negativeAmount'}"
                        infoState="Success"
                    />
                </List>

                <HBox justifyContent="End" alignItems="Center" visible="{= ${tracking>/order/DiscountAmount} > 0 }" class="sapUiSmallMarginTop">
                    <Text text="{i18n>subtotal}" class="sapUiSmallMarginEnd" />
                    <Text text="{path: 'tracking>/order/SubtotalAmount', formatter: '.formatter.currency'}" />
                </HBox>
                <HBox justifyContent="End" alignItems="Center" visible="{= ${tracking>/order/DiscountAmount} > 0 }">
                    <Text text="{i18n>discount}" class="sapUiSmallMarginEnd" />
                    <ObjectStatus text="{path: 'tracking>/order/DiscountAmount', formatter: '.formatter.negativeAmount'}" state="Success" />
                </HBox>
                <HBox justifyContent="End" alignItems="Center" class="blCartTotal">
                    <Text text="{i18n>total}" class="sapUiSmallMarginEnd" />
                    <Text text="{path: 'tracking>/order/TotalAmount', targetType: 'any', formatter: '.formatter.currency'}" class="blDetailPrice" />
                </HBox>

                <HBox justifyContent="End" class="sapUiMediumMarginTop">
                    <Button text="{i18n>continueShopping}" press=".onContinueShopping" class="sapUiSmallMarginEnd" />
                    <Button
                        text="{i18n>talkOnWhatsapp}"
                        icon="sap-icon://discussion"
                        type="Success"
                        press=".onContactWhatsapp"
                        visible="{= !!${store>/Whatsapp} }"
                    />
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
