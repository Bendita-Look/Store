<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="orderReturnDialog"
        title="{parts: ['i18n>returnDialogTitle', 'return>/number'], formatter: '.formatter.message'}"
        contentWidth="46rem"
        resizable="true"
        class="blDialog"
    >
        <content>
            <VBox class="sapUiSmallMargin">
                <MessageStrip text="{i18n>returnInfo}" type="Information" showIcon="true" class="sapUiSmallMarginBottom" />

                <Table items="{return>/rows}" headerText="{i18n>returnItemsTitle}" popinLayout="GridSmall" class="blTable">
                    <columns>
                        <Column>
                            <Text text="{i18n>product}" />
                        </Column>
                        <Column hAlign="Center" width="6rem" minScreenWidth="Tablet" demandPopin="true">
                            <Text text="{i18n>returnAvailable}" />
                        </Column>
                        <Column hAlign="Center" width="8rem" minScreenWidth="Tablet" demandPopin="true">
                            <Text text="{i18n>returnQuantity}" />
                        </Column>
                        <Column hAlign="Center" width="7rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>restock}" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <HBox alignItems="Center">
                                    <Image
                                        src="{path: 'return>ImageId', formatter: '.formatter.catalogImageUrl'}"
                                        width="2.5rem"
                                        height="3.25rem"
                                        densityAware="false"
                                        class="blCartImage sapUiSmallMarginEnd"
                                    />
                                    <Text text="{return>Description}" />
                                </HBox>
                                <Text text="{parts: ['i18n>returnAvailableOf', 'return>Available', 'return>Purchased'], formatter: '.formatter.message'}" />
                                <StepInput
                                    value="{return>Quantity}"
                                    min="0"
                                    max="{return>Available}"
                                    enabled="{= ${return>Available} > 0 }"
                                    width="7rem"
                                    change=".orderReturn.onReturnQuantityChange"
                                />
                                <CheckBox selected="{return>Restock}" enabled="{= ${return>Quantity} > 0 }" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <Label text="{i18n>returnReason}" class="sapUiSmallMarginTop" />
                <TextArea value="{return>/reason}" maxLength="255" rows="2" width="100%" placeholder="{i18n>returnReasonPlaceholder}" />

                <Title text="{i18n>replacementTitle}" level="H4" class="sapUiSmallMarginTop" />
                <HBox alignItems="End" wrap="Wrap">
                    <VBox class="sapUiSmallMarginEnd blGrow">
                        <Label text="{i18n>product}" />
                        <ComboBox
                            id="returnVariantCombo"
                            selectedKey="{return>/selectedVariantId}"
                            width="100%"
                            showSecondaryValues="true"
                            items="{
                                path: '/ProductVariants',
                                parameters: {
                                    $filter: 'IsActiveEntity eq true and Stock gt 0 and Product/Active eq true',
                                    $expand: 'Product($select=Name,Price,Active),Color($select=Name)',
                                    $select: 'ID,Size,Stock'
                                },
                                templateShareable: false
                            }"
                        >
                            <core:ListItem
                                key="{ID}"
                                text="{parts: ['Product/Name', 'Color/Name', 'Size'], formatter: '.formatter.variantDescription'}"
                                additionalText="{parts: ['i18n>inStock', 'i18n>soldOut', {path: 'Stock', targetType: 'any'}], formatter: '.formatter.stockMessage'}"
                            />
                        </ComboBox>
                    </VBox>
                    <VBox class="sapUiSmallMarginEnd">
                        <Label text="{i18n>quantity}" />
                        <StepInput value="{return>/quantity}" min="1" max="20" width="7rem" />
                    </VBox>
                    <Button text="{i18n>addItem}" icon="sap-icon://add" press=".orderReturn.onAddLine" />
                </HBox>

                <Table
                    items="{return>/lines}"
                    visible="{= ${return>/lines}.length > 0 }"
                    popinLayout="GridSmall"
                    class="blTable sapUiSmallMarginTop"
                >
                    <columns>
                        <Column>
                            <Text text="{i18n>product}" />
                        </Column>
                        <Column hAlign="Center" width="8rem" minScreenWidth="Tablet" demandPopin="true">
                            <Text text="{i18n>quantity}" />
                        </Column>
                        <Column hAlign="End" width="7rem" minScreenWidth="Tablet" demandPopin="true">
                            <Text text="{i18n>unitPrice}" />
                        </Column>
                        <Column width="3rem" hAlign="End" />
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{return>Description}" />
                                <StepInput value="{return>Quantity}" min="1" max="{= ${return>Stock} || 20 }" width="7rem" change=".orderReturn.onLineQuantityChange" />
                                <Text text="{path: 'return>UnitPrice', formatter: '.formatter.currency'}" />
                                <Button icon="sap-icon://delete" type="Transparent" tooltip="{i18n>remove}" press=".orderReturn.onRemoveLine" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <VBox visible="{= !!${return>/quote} }" class="blReturnSummary">
                    <HBox justifyContent="SpaceBetween">
                        <Text text="{i18n>refundAmount}" />
                        <Text text="{path: 'return>/quote/RefundAmount', formatter: '.formatter.currency'}" />
                    </HBox>
                    <HBox justifyContent="SpaceBetween" visible="{= ${return>/quote/ExchangeAmount} > 0 }">
                        <Text text="{i18n>exchangeAmount}" />
                        <Text text="{path: 'return>/quote/ExchangeAmount', formatter: '.formatter.currency'}" />
                    </HBox>
                    <Text text="{return>/balanceText}" class="blReturnBalance" />
                </VBox>
            </VBox>
        </content>
        <buttons>
            <Button text="{i18n>confirmReturn}" type="Emphasized" icon="sap-icon://accept" press=".orderReturn.onConfirm" />
            <Button text="{i18n>cancel}" press=".orderReturn.onClose" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
